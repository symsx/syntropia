.DS_Store
Thumbs.db
*.tmp
~$*
__pycache__/
*.pyc

# Configuration locale — jamais dans le dépôt
config/local.env
config/base.php

# Permissions Claude Code accordées en local — spécifiques à la machine,
# rien à voir avec le projet (settings.local.json l'est déjà, via le
# gitignore global de l'utilisateur ; settings.json ne l'était pas).
.claude/settings.json

# Dossier de dépôt manuel (bin/deployer.py preparer) — voisin du
# projet, pas dedans ; cette ligne est une redondance volontaire.
/syntropia-depot/

# Le déploiement en ligne — écrit sur le serveur par bin/deployer.py fichiers, jamais dans le dépôt
# (chantier-mises-a-jour.md, Phase 4). Un fichier local ne sert qu'aux essais.
contenu/deploiement.txt
# Les traces d'activité des comptes (Authentification::noterActivite) — propres à chaque serveur.
contenu/actifs/
